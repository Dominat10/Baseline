{
  "version": "0.5.0",
  "steps": [
    {
      "id": "company",
      "title": {
        "ar": "الشركة",
        "en": "Company"
      },
      "fields": [
        "companyName",
        "profile",
        "size"
      ]
    },
    {
      "id": "data",
      "title": {
        "ar": "العملاء والبيانات",
        "en": "Clients & data"
      },
      "fields": [
        "clients",
        "personalData",
        "platform",
        "m365Licence",
        "googleLicence",
        "hosting",
        "saasToGov"
      ]
    },
    {
      "id": "people",
      "title": {
        "ar": "الأشخاص",
        "en": "People"
      },
      "fields": [
        "ownerName",
        "ownerTitle",
        "deputyName",
        "approverTitle",
        "itManagedBy",
        "workforce"
      ]
    },
    {
      "id": "work",
      "title": {
        "ar": "طريقة العمل",
        "en": "Ways of working"
      },
      "fields": [
        "workModel",
        "byod",
        "aiTools"
      ]
    },
    {
      "id": "continuity",
      "title": {
        "ar": "الاستمرارية",
        "en": "Continuity"
      },
      "fields": [
        "maxDowntime",
        "maxDataLoss",
        "irPartner"
      ]
    },
    {
      "id": "today",
      "title": {
        "ar": "الوضع الحالي",
        "en": "Today"
      },
      "fields": [
        "capabilities"
      ]
    },
    {
      "id": "dates",
      "title": {
        "ar": "الإصدار",
        "en": "Issue"
      },
      "fields": [
        "effectiveDate",
        "reviewMonths"
      ]
    }
  ],
  "fields": {
    "companyName": {
      "type": "text",
      "label": {
        "ar": "اسم الشركة كما تريده في السياسة",
        "en": "Company name as it should appear"
      },
      "placeholder": {
        "ar": "مثال: شركة النخبة للبرمجيات",
        "en": "e.g. Nukhba Software Co."
      },
      "required": true
    },
    "profile": {
      "type": "multi",
      "label": {
        "ar": "نوع العمل (اختر كل ما ينطبق)",
        "en": "Business type (pick all that apply)"
      },
      "help": {
        "ar": "يضيف بنودًا خاصة بنوع عملك.",
        "en": "Adds clauses specific to your business."
      },
      "options": [
        {
          "value": "dev",
          "label": {
            "ar": "شركة برمجيات",
            "en": "Software house"
          }
        },
        {
          "value": "product",
          "label": {
            "ar": "منتج رقمي",
            "en": "Digital product"
          }
        },
        {
          "value": "supplier",
          "label": {
            "ar": "مورّد خدمات",
            "en": "Service supplier"
          }
        },
        {
          "value": "shop",
          "label": {
            "ar": "متجر إلكتروني",
            "en": "Online store"
          }
        }
      ],
      "required": true
    },
    "size": {
      "type": "select",
      "label": {
        "ar": "عدد الموظفين",
        "en": "Number of employees"
      },
      "help": {
        "ar": "يحدد هل ضوابط الهيئة إلزامية عليك.",
        "en": "Decides whether NCA controls are mandatory for you."
      },
      "options": [
        {
          "value": "micro",
          "label": {
            "ar": "أقل من 6",
            "en": "Fewer than 6"
          }
        },
        {
          "value": "sme",
          "label": {
            "ar": "6 إلى 249",
            "en": "6 to 249"
          }
        },
        {
          "value": "large",
          "label": {
            "ar": "250 أو أكثر",
            "en": "250 or more"
          }
        }
      ],
      "required": true
    },
    "clients": {
      "type": "multi",
      "label": {
        "ar": "من عملاؤك؟ (اختر كل ما ينطبق)",
        "en": "Who are your clients? (pick all that apply)"
      },
      "help": {
        "ar": "العملاء الحكوميون والماليون يفرضون متطلبات أمنية على مورديهم.",
        "en": "Government and financial clients impose security requirements on their suppliers."
      },
      "options": [
        {
          "value": "government",
          "label": {
            "ar": "جهات حكومية",
            "en": "Government entities"
          }
        },
        {
          "value": "finance",
          "label": {
            "ar": "بنوك وجهات مالية",
            "en": "Banks and financial institutions"
          }
        },
        {
          "value": "private",
          "label": {
            "ar": "شركات خاصة",
            "en": "Private companies"
          }
        },
        {
          "value": "consumers",
          "label": {
            "ar": "أفراد (مستهلكون)",
            "en": "Individuals (consumers)"
          }
        }
      ],
      "required": true
    },
    "personalData": {
      "type": "multi",
      "exclusive": "none",
      "label": {
        "ar": "ما البيانات الشخصية التي تحتفظ بها؟",
        "en": "What personal data do you hold?"
      },
      "help": {
        "ar": "بيانات العملاء أو الموظفين أو المستخدمين.",
        "en": "About customers, staff or users."
      },
      "options": [
        {
          "value": "none",
          "label": {
            "ar": "لا نحتفظ ببيانات شخصية",
            "en": "None"
          }
        },
        {
          "value": "contact",
          "label": {
            "ar": "بيانات التواصل",
            "en": "contact details"
          }
        },
        {
          "value": "ids",
          "label": {
            "ar": "أرقام الهوية والإقامة",
            "en": "ID and Iqama numbers"
          }
        },
        {
          "value": "financial",
          "label": {
            "ar": "بيانات مالية",
            "en": "financial data"
          }
        },
        {
          "value": "health",
          "label": {
            "ar": "بيانات صحية",
            "en": "health data"
          }
        }
      ],
      "required": true
    },
    "platform": {
      "type": "multi",
      "label": {
        "ar": "أين تعمل أنظمتكم الرئيسية؟",
        "en": "Where do your main systems run?"
      },
      "options": [
        {
          "value": "m365",
          "label": {
            "ar": "Microsoft 365",
            "en": "Microsoft 365"
          }
        },
        {
          "value": "google",
          "label": {
            "ar": "Google Workspace",
            "en": "Google Workspace"
          }
        },
        {
          "value": "servers",
          "label": {
            "ar": "خوادم خاصة بالشركة",
            "en": "the company's own servers"
          }
        },
        {
          "value": "cloud",
          "label": {
            "ar": "خدمات سحابية أخرى",
            "en": "other cloud services"
          }
        }
      ],
      "required": true
    },
    "m365Licence": {
      "type": "select",
      "label": {
        "ar": "ما إصدار Microsoft 365 لديكم؟",
        "en": "Which Microsoft 365 plan do you have?"
      },
      "help": {
        "ar": "يحدد ما هو مشمول في اشتراكك فعلًا ولا تحتاج لشرائه.",
        "en": "Decides what's already included in what you pay for."
      },
      "showIf": {
        "platform": [
          "m365"
        ]
      },
      "options": [
        {
          "value": "basic",
          "label": {
            "ar": "Business Basic",
            "en": "Business Basic"
          }
        },
        {
          "value": "standard",
          "label": {
            "ar": "Business Standard",
            "en": "Business Standard"
          }
        },
        {
          "value": "premium",
          "label": {
            "ar": "Business Premium",
            "en": "Business Premium"
          }
        },
        {
          "value": "enterprise",
          "label": {
            "ar": "E3 أو E5",
            "en": "E3 or E5"
          }
        },
        {
          "value": "unsure",
          "label": {
            "ar": "غير متأكد",
            "en": "Not sure"
          }
        }
      ],
      "required": true
    },
    "googleLicence": {
      "type": "select",
      "label": {
        "ar": "ما إصدار Google Workspace لديكم؟",
        "en": "Which Google Workspace plan do you have?"
      },
      "help": {
        "ar": "يحدد ما هو مشمول في اشتراكك فعلًا ولا تحتاج لشرائه.",
        "en": "Decides what's already included in what you pay for."
      },
      "showIf": {
        "platform": [
          "google"
        ]
      },
      "options": [
        {
          "value": "starter",
          "label": {
            "ar": "Business Starter",
            "en": "Business Starter"
          }
        },
        {
          "value": "standard",
          "label": {
            "ar": "Business Standard",
            "en": "Business Standard"
          }
        },
        {
          "value": "plus",
          "label": {
            "ar": "Business Plus",
            "en": "Business Plus"
          }
        },
        {
          "value": "enterprise",
          "label": {
            "ar": "Enterprise",
            "en": "Enterprise"
          }
        },
        {
          "value": "unsure",
          "label": {
            "ar": "غير متأكد",
            "en": "Not sure"
          }
        }
      ],
      "required": true
    },
    "hosting": {
      "type": "select",
      "label": {
        "ar": "أين تُستضاف بياناتكم؟",
        "en": "Where is your data hosted?"
      },
      "help": {
        "ar": "موقع الخوادم أو منطقة الخدمة السحابية.",
        "en": "The location of your servers or cloud region."
      },
      "options": [
        {
          "value": "ksa",
          "label": {
            "ar": "داخل السعودية",
            "en": "Inside Saudi Arabia"
          }
        },
        {
          "value": "outside",
          "label": {
            "ar": "خارج السعودية",
            "en": "Outside Saudi Arabia"
          }
        },
        {
          "value": "unsure",
          "label": {
            "ar": "غير متأكد",
            "en": "Not sure"
          }
        }
      ],
      "required": true
    },
    "saasToGov": {
      "type": "select",
      "label": {
        "ar": "هل تقدمون برمجياتكم كخدمة سحابية (SaaS) لجهات حكومية؟",
        "en": "Do you provide your software as a cloud service (SaaS) to government entities?"
      },
      "help": {
        "ar": "قد يُدخلكم ذلك في نطاق ضوابط الأمن السيبراني للحوسبة السحابية بصفتكم مقدّم خدمة.",
        "en": "This may bring you into scope of NCA's cloud controls as a service provider."
      },
      "showIf": {
        "profile": [
          "dev",
          "product"
        ],
        "clients": [
          "government"
        ]
      },
      "options": [
        {
          "value": "yes",
          "label": {
            "ar": "نعم",
            "en": "Yes"
          }
        },
        {
          "value": "no",
          "label": {
            "ar": "لا",
            "en": "No"
          }
        }
      ],
      "required": true
    },
    "ownerName": {
      "type": "text",
      "label": {
        "ar": "اسم مسؤول الأمن السيبراني",
        "en": "Security owner's name"
      },
      "help": {
        "ar": "شخص واحد مسؤول، حتى لو لم يكن هذا عمله الوحيد.",
        "en": "One accountable person, even if it isn't their only job."
      },
      "placeholder": {
        "ar": "مثال: أحمد العتيبي",
        "en": "e.g. Ahmed Alotaibi"
      },
      "required": true
    },
    "ownerTitle": {
      "type": "text",
      "label": {
        "ar": "مسماه الوظيفي",
        "en": "Their job title"
      },
      "placeholder": {
        "ar": "مثال: مدير العمليات",
        "en": "e.g. Operations Manager"
      },
      "required": true
    },
    "deputyName": {
      "type": "text",
      "label": {
        "ar": "من ينوب عنه في الحوادث؟",
        "en": "Who covers for them in an incident?"
      },
      "help": {
        "ar": "شخص ثانٍ يتولى القيادة إذا لم يكن المسؤول متاحًا.",
        "en": "A second person who takes charge if the owner isn't available."
      },
      "placeholder": {
        "ar": "مثال: سارة القحطاني",
        "en": "e.g. Sara Alqahtani"
      },
      "required": true
    },
    "approverTitle": {
      "type": "select",
      "label": {
        "ar": "من يعتمد السياسة؟",
        "en": "Who approves the policy?"
      },
      "options": [
        {
          "value": "ceo",
          "label": {
            "ar": "الرئيس التنفيذي",
            "en": "Chief Executive Officer"
          }
        },
        {
          "value": "gm",
          "label": {
            "ar": "المدير العام",
            "en": "General Manager"
          }
        },
        {
          "value": "owner",
          "label": {
            "ar": "المالك / الشريك المدير",
            "en": "Owner / Managing Partner"
          }
        },
        {
          "value": "board",
          "label": {
            "ar": "مجلس الإدارة",
            "en": "Board of Directors"
          }
        }
      ],
      "required": true
    },
    "itManagedBy": {
      "type": "select",
      "label": {
        "ar": "من يدير تقنية المعلومات يوميًا؟",
        "en": "Who runs your IT day to day?"
      },
      "options": [
        {
          "value": "inhouse",
          "label": {
            "ar": "موظف لدينا",
            "en": "One of our employees"
          }
        },
        {
          "value": "provider",
          "label": {
            "ar": "شركة أو مستقل خارجي",
            "en": "An outside company or freelancer"
          }
        },
        {
          "value": "nobody",
          "label": {
            "ar": "لا أحد محدد",
            "en": "No one in particular"
          }
        }
      ],
      "required": true
    },
    "workforce": {
      "type": "multi",
      "exclusive": "staff",
      "label": {
        "ar": "من غير الموظفين يصل إلى أنظمتكم أو بياناتكم؟",
        "en": "Besides employees, who accesses your systems or data?"
      },
      "options": [
        {
          "value": "staff",
          "label": {
            "ar": "الموظفون فقط",
            "en": "Employees only"
          }
        },
        {
          "value": "contractors",
          "label": {
            "ar": "مستقلون أو متعاقدون داخل السعودية",
            "en": "Freelancers or contractors in Saudi Arabia"
          }
        },
        {
          "value": "offshore",
          "label": {
            "ar": "فرق أو متعاقدون خارج السعودية",
            "en": "Teams or contractors outside Saudi Arabia"
          }
        }
      ],
      "required": true
    },
    "workModel": {
      "type": "select",
      "label": {
        "ar": "أين يعمل الفريق؟",
        "en": "Where does the team work?"
      },
      "options": [
        {
          "value": "office",
          "label": {
            "ar": "من المكتب فقط",
            "en": "Office only"
          }
        },
        {
          "value": "hybrid",
          "label": {
            "ar": "مختلط (مكتب وعن بُعد)",
            "en": "Hybrid (office and remote)"
          }
        },
        {
          "value": "remote",
          "label": {
            "ar": "عن بُعد بالكامل",
            "en": "Fully remote"
          }
        }
      ],
      "required": true
    },
    "byod": {
      "type": "select",
      "label": {
        "ar": "هل يُسمح باستخدام الأجهزة الشخصية في العمل؟",
        "en": "Can people use personal devices for work?"
      },
      "options": [
        {
          "value": "no",
          "label": {
            "ar": "لا، أجهزة الشركة فقط",
            "en": "No, company devices only"
          }
        },
        {
          "value": "phones",
          "label": {
            "ar": "الجوال فقط",
            "en": "Phones only"
          }
        },
        {
          "value": "all",
          "label": {
            "ar": "الجوال والحاسوب",
            "en": "Phones and laptops"
          }
        }
      ],
      "required": true
    },
    "aiTools": {
      "type": "select",
      "label": {
        "ar": "أدوات الذكاء الاصطناعي (مثل ChatGPT) في العمل",
        "en": "AI tools (like ChatGPT) at work"
      },
      "help": {
        "ar": "أكبر قناة جديدة لتسرب البيانات.",
        "en": "The biggest new channel for data leaks."
      },
      "options": [
        {
          "value": "banned",
          "label": {
            "ar": "غير مسموحة",
            "en": "Not allowed"
          }
        },
        {
          "value": "approved",
          "label": {
            "ar": "أدوات معتمدة فقط",
            "en": "Approved tools only"
          }
        }
      ],
      "required": true
    },
    "maxDowntime": {
      "type": "select",
      "label": {
        "ar": "أقصى مدة يمكن أن تتوقف فيها أنظمتكم الأساسية",
        "en": "Longest your core systems can be down"
      },
      "help": {
        "ar": "قبل أن تبدأ خسارة حقيقية في العملاء أو الإيراد.",
        "en": "Before you start really losing customers or revenue."
      },
      "options": [
        {
          "value": "4h",
          "label": {
            "ar": "4 ساعات",
            "en": "4 hours"
          }
        },
        {
          "value": "1d",
          "label": {
            "ar": "يوم واحد",
            "en": "1 day"
          }
        },
        {
          "value": "3d",
          "label": {
            "ar": "3 أيام",
            "en": "3 days"
          }
        }
      ],
      "required": true
    },
    "maxDataLoss": {
      "type": "select",
      "label": {
        "ar": "أقصى قدر من العمل يمكن أن تفقدوه",
        "en": "Most recent work you could afford to lose"
      },
      "help": {
        "ar": "مثلًا: لو اضطررتم للاسترجاع من نسخة أمس، هل هذا مقبول؟",
        "en": "For example: if you had to restore yesterday's copy, is that acceptable?"
      },
      "options": [
        {
          "value": "1h",
          "label": {
            "ar": "ساعة واحدة",
            "en": "1 hour"
          }
        },
        {
          "value": "1d",
          "label": {
            "ar": "يوم واحد",
            "en": "1 day"
          }
        },
        {
          "value": "1w",
          "label": {
            "ar": "أسبوع واحد",
            "en": "1 week"
          }
        }
      ],
      "required": true
    },
    "irPartner": {
      "type": "select",
      "label": {
        "ar": "هل لديكم شركة متخصصة تتصلون بها عند الاختراق؟",
        "en": "Do you have a specialist firm to call if you're breached?"
      },
      "options": [
        {
          "value": "yes",
          "label": {
            "ar": "نعم",
            "en": "Yes"
          }
        },
        {
          "value": "no",
          "label": {
            "ar": "لا",
            "en": "No"
          }
        }
      ],
      "required": true
    },
    "effectiveDate": {
      "type": "date",
      "label": {
        "ar": "تاريخ السريان",
        "en": "Effective date"
      },
      "required": true
    },
    "reviewMonths": {
      "type": "select",
      "label": {
        "ar": "مراجعة السياسة كل",
        "en": "Review the policy every"
      },
      "options": [
        {
          "value": "6",
          "label": {
            "ar": "6 أشهر",
            "en": "6 months"
          }
        },
        {
          "value": "12",
          "label": {
            "ar": "12 شهرًا",
            "en": "12 months"
          }
        }
      ],
      "default": "12",
      "required": true
    },
    "capabilities": {
      "type": "multi",
      "exclusive": "none",
      "label": {
        "ar": "ما المطبَّق لديكم اليوم فعليًا؟",
        "en": "What is actually in place today?"
      },
      "help": {
        "ar": "كن دقيقًا: السياسة ستذكر ما هو مطبق، وتضع موعدًا مستهدفًا للباقي. هذا ما يجعلها صامدة أمام أي تدقيق.",
        "en": "Be honest: the policy states what's in place and sets a target date for the rest. That's what makes it hold up in an audit."
      },
      "options": [
        {
          "value": "none",
          "label": {
            "ar": "لا شيء مما يلي بعد",
            "en": "None of these yet"
          }
        },
        {
          "value": "mfa",
          "targetDays": 30,
          "label": {
            "ar": "التحقق بخطوتين على البريد وحسابات المسؤولين",
            "en": "Two-step login on email and admin accounts"
          }
        },
        {
          "value": "offboarding",
          "targetDays": 30,
          "label": {
            "ar": "إغلاق الصلاحيات في يوم مغادرة الموظف",
            "en": "Access removed the day someone leaves"
          }
        },
        {
          "value": "backups",
          "targetDays": 30,
          "label": {
            "ar": "نسخ احتياطي تلقائي",
