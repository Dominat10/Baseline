{
  "version": "0.3.0",
  "steps": [
    {
      "id": "company",
      "title": {
        "ar": "الشركة",
        "en": "Company"
      },
      "fields": [
        "companyName",
        "profile",
        "size"
      ]
    },
    {
      "id": "data",
      "title": {
        "ar": "العملاء والبيانات",
        "en": "Clients & data"
      },
      "fields": [
        "clients",
        "personalData",
        "platform",
        "hosting",
        "saasToGov"
      ]
    },
    {
      "id": "people",
      "title": {
        "ar": "الأشخاص",
        "en": "People"
      },
      "fields": [
        "ownerName",
        "ownerTitle",
        "approverTitle",
        "itManagedBy",
        "workforce"
      ]
    },
    {
      "id": "today",
      "title": {
        "ar": "الوضع الحالي",
        "en": "Today"
      },
      "fields": [
        "capabilities"
      ]
    },
    {
      "id": "dates",
      "title": {
        "ar": "الإصدار",
        "en": "Issue"
      },
      "fields": [
        "effectiveDate",
        "reviewMonths"
      ]
    }
  ],
  "fields": {
    "companyName": {
      "type": "text",
      "label": {
        "ar": "اسم الشركة كما تريده في السياسة",
        "en": "Company name as it should appear"
      },
      "placeholder": {
        "ar": "مثال: شركة النخبة للبرمجيات",
        "en": "e.g. Nukhba Software Co."
      },
      "required": true
    },
    "profile": {
      "type": "multi",
      "label": {
        "ar": "نوع العمل (اختر كل ما ينطبق)",
        "en": "Business type (pick all that apply)"
      },
      "help": {
        "ar": "يضيف بنودًا خاصة بنوع عملك.",
        "en": "Adds clauses specific to your business."
      },
      "options": [
        {
          "value": "dev",
          "label": {
            "ar": "شركة برمجيات",
            "en": "Software house"
          }
        },
        {
          "value": "product",
          "label": {
            "ar": "منتج رقمي",
            "en": "Digital product"
          }
        },
        {
          "value": "supplier",
          "label": {
            "ar": "مورّد خدمات",
            "en": "Service supplier"
          }
        },
        {
          "value": "shop",
          "label": {
            "ar": "متجر إلكتروني",
            "en": "Online store"
          }
        }
      ],
      "required": true
    },
    "size": {
      "type": "select",
      "label": {
        "ar": "عدد الموظفين",
        "en": "Number of employees"
      },
      "help": {
        "ar": "يحدد هل ضوابط الهيئة إلزامية عليك.",
        "en": "Decides whether NCA controls are mandatory for you."
      },
      "options": [
        {
          "value": "micro",
          "label": {
            "ar": "أقل من 6",
            "en": "Fewer than 6"
          }
        },
        {
          "value": "sme",
          "label": {
            "ar": "6 إلى 249",
            "en": "6 to 249"
          }
        },
        {
          "value": "large",
          "label": {
            "ar": "250 أو أكثر",
            "en": "250 or more"
          }
        }
      ],
      "required": true
    },
    "clients": {
      "type": "multi",
      "label": {
        "ar": "من عملاؤك؟ (اختر كل ما ينطبق)",
        "en": "Who are your clients? (pick all that apply)"
      },
      "help": {
        "ar": "العملاء الحكوميون والماليون يفرضون متطلبات أمنية على مورديهم.",
        "en": "Government and financial clients impose security requirements on their suppliers."
      },
      "options": [
        {
          "value": "government",
          "label": {
            "ar": "جهات حكومية",
            "en": "Government entities"
          }
        },
        {
          "value": "finance",
          "label": {
            "ar": "بنوك وجهات مالية",
            "en": "Banks and financial institutions"
          }
        },
        {
          "value": "private",
          "label": {
            "ar": "شركات خاصة",
            "en": "Private companies"
          }
        },
        {
          "value": "consumers",
          "label": {
            "ar": "أفراد (مستهلكون)",
            "en": "Individuals (consumers)"
          }
        }
      ],
      "required": true
    },
    "personalData": {
      "type": "multi",
      "exclusive": "none",
      "label": {
        "ar": "ما البيانات الشخصية التي تحتفظ بها؟",
        "en": "What personal data do you hold?"
      },
      "help": {
        "ar": "بيانات العملاء أو الموظفين أو المستخدمين.",
        "en": "About customers, staff or users."
      },
      "options": [
        {
          "value": "none",
          "label": {
            "ar": "لا نحتفظ ببيانات شخصية",
            "en": "None"
          }
        },
        {
          "value": "contact",
          "label": {
            "ar": "بيانات التواصل",
            "en": "contact details"
          }
        },
        {
          "value": "ids",
          "label": {
            "ar": "أرقام الهوية والإقامة",
            "en": "ID and Iqama numbers"
          }
        },
        {
          "value": "financial",
          "label": {
            "ar": "بيانات مالية",
            "en": "financial data"
          }
        },
        {
          "value": "health",
          "label": {
            "ar": "بيانات صحية",
            "en": "health data"
          }
        }
      ],
      "required": true
    },
    "platform": {
      "type": "multi",
      "label": {
        "ar": "أين تعمل أنظمتكم الرئيسية؟",
        "en": "Where do your main systems run?"
      },
      "options": [
        {
          "value": "m365",
          "label": {
            "ar": "Microsoft 365",
            "en": "Microsoft 365"
          }
        },
        {
          "value": "google",
          "label": {
            "ar": "Google Workspace",
            "en": "Google Workspace"
          }
        },
        {
          "value": "servers",
          "label": {
            "ar": "خوادم خاصة بالشركة",
            "en": "the company's own servers"
          }
        },
        {
          "value": "cloud",
          "label": {
            "ar": "خدمات سحابية أخرى",
            "en": "other cloud services"
          }
        }
      ],
      "required": true
    },
    "hosting": {
      "type": "select",
      "label": {
        "ar": "أين تُستضاف بياناتكم؟",
        "en": "Where is your data hosted?"
      },
      "help": {
        "ar": "موقع الخوادم أو منطقة الخدمة السحابية.",
        "en": "The location of your servers or cloud region."
      },
      "options": [
        {
          "value": "ksa",
          "label": {
            "ar": "داخل السعودية",
            "en": "Inside Saudi Arabia"
          }
        },
        {
          "value": "outside",
          "label": {
            "ar": "خارج السعودية",
            "en": "Outside Saudi Arabia"
          }
        },
        {
          "value": "unsure",
          "label": {
            "ar": "غير متأكد",
            "en": "Not sure"
          }
        }
      ],
      "required": true
    },
    "saasToGov": {
      "type": "select",
      "label": {
        "ar": "هل تقدمون برمجياتكم كخدمة سحابية (SaaS) لجهات حكومية؟",
        "en": "Do you provide your software as a cloud service (SaaS) to government entities?"
      },
      "help": {
        "ar": "قد يُدخلكم ذلك في نطاق ضوابط الأمن السيبراني للحوسبة السحابية بصفتكم مقدّم خدمة.",
        "en": "This may bring you into scope of NCA's cloud controls as a service provider."
      },
      "showIf": {
        "profile": [
          "dev",
          "product"
        ],
        "clients": [
          "government"
        ]
      },
      "options": [
        {
          "value": "yes",
          "label": {
            "ar": "نعم",
            "en": "Yes"
          }
        },
        {
          "value": "no",
          "label": {
            "ar": "لا",
            "en": "No"
          }
        }
      ],
      "required": true
    },
    "ownerName": {
      "type": "text",
      "label": {
        "ar": "اسم مسؤول الأمن السيبراني",
        "en": "Security owner's name"
      },
      "help": {
        "ar": "شخص واحد مسؤول، حتى لو لم يكن هذا عمله الوحيد.",
        "en": "One accountable person, even if it isn't their only job."
      },
      "placeholder": {
        "ar": "مثال: أحمد العتيبي",
        "en": "e.g. Ahmed Alotaibi"
      },
      "required": true
    },
    "ownerTitle": {
      "type": "text",
      "label": {
        "ar": "مسماه الوظيفي",
        "en": "Their job title"
      },
      "placeholder": {
        "ar": "مثال: مدير العمليات",
        "en": "e.g. Operations Manager"
      },
      "required": true
    },
    "approverTitle": {
      "type": "select",
      "label": {
        "ar": "من يعتمد السياسة؟",
        "en": "Who approves the policy?"
      },
      "options": [
        {
          "value": "ceo",
          "label": {
            "ar": "الرئيس التنفيذي",
            "en": "Chief Executive Officer"
          }
        },
        {
          "value": "gm",
          "label": {
            "ar": "المدير العام",
            "en": "General Manager"
          }
        },
        {
          "value": "owner",
          "label": {
            "ar": "المالك / الشريك المدير",
            "en": "Owner / Managing Partner"
          }
        },
        {
          "value": "board",
          "label": {
            "ar": "مجلس الإدارة",
            "en": "Board of Directors"
          }
        }
      ],
      "required": true
    },
    "itManagedBy": {
      "type": "select",
      "label": {
        "ar": "من يدير تقنية المعلومات يوميًا؟",
        "en": "Who runs your IT day to day?"
      },
      "options": [
        {
          "value": "inhouse",
          "label": {
            "ar": "موظف لدينا",
            "en": "One of our employees"
          }
        },
        {
          "value": "provider",
          "label": {
            "ar": "شركة أو مستقل خارجي",
            "en": "An outside company or freelancer"
          }
        },
        {
          "value": "nobody",
          "label": {
            "ar": "لا أحد محدد",
            "en": "No one in particular"
          }
        }
      ],
      "required": true
    },
    "workforce": {
      "type": "multi",
      "exclusive": "staff",
      "label": {
        "ar": "من غير الموظفين يصل إلى أنظمتكم أو بياناتكم؟",
        "en": "Besides employees, who accesses your systems or data?"
      },
      "options": [
        {
          "value": "staff",
          "label": {
            "ar": "الموظفون فقط",
            "en": "Employees only"
          }
        },
        {
          "value": "contractors",
          "label": {
            "ar": "مستقلون أو متعاقدون داخل السعودية",
            "en": "Freelancers or contractors in Saudi Arabia"
          }
        },
        {
          "value": "offshore",
          "label": {
            "ar": "فرق أو متعاقدون خارج السعودية",
            "en": "Teams or contractors outside Saudi Arabia"
          }
        }
      ],
      "required": true
    },
    "effectiveDate": {
      "type": "date",
      "label": {
        "ar": "تاريخ السريان",
        "en": "Effective date"
      },
      "required": true
    },
    "reviewMonths": {
      "type": "select",
      "label": {
        "ar": "مراجعة السياسة كل",
        "en": "Review the policy every"
      },
      "options": [
        {
          "value": "6",
          "label": {
            "ar": "6 أشهر",
            "en": "6 months"
          }
        },
        {
          "value": "12",
          "label": {
            "ar": "12 شهرًا",
            "en": "12 months"
          }
        }
      ],
      "default": "12",
      "required": true
    },
    "capabilities": {
      "type": "multi",
      "exclusive": "none",
      "label": {
        "ar": "ما المطبَّق لديكم اليوم فعليًا؟",
        "en": "What is actually in place today?"
      },
      "help": {
        "ar": "كن دقيقًا: السياسة ستذكر ما هو مطبق، وتضع موعدًا مستهدفًا للباقي. هذا ما يجعلها صامدة أمام أي تدقيق.",
        "en": "Be honest: the policy states what's in place and sets a target date for the rest. That's what makes it hold up in an audit."
      },
      "options": [
        {
          "value": "none",
          "label": {
            "ar": "لا شيء مما يلي بعد",
            "en": "None of these yet"
          }
        },
        {
          "value": "mfa",
          "targetDays": 30,
          "label": {
            "ar": "التحقق بخطوتين على البريد وحسابات المسؤولين",
            "en": "Two-step login on email and admin accounts"
          }
        },
        {
          "value": "offboarding",
          "targetDays": 30,
          "label": {
            "ar": "إغلاق الصلاحيات في يوم مغادرة الموظف",
            "en": "Access removed the day someone leaves"
          }
        },
        {
          "value": "backups",
          "targetDays": 30,
          "label": {
            "ar": "نسخ احتياطي تلقائي",
            "en": "Automatic backups"
          }
        },
        {
          "value": "restoreTest",
          "targetDays": 90,
          "label": {
            "ar": "تجربة استعادة من النسخ الاحتياطي",
            "en": "A tested restore from backup"
          }
        },
        {
          "value": "logging",
          "targetDays": 90,
          "label": {
            "ar": "الاحتفاظ بسجلات الدخول والنشاط",
            "en": "Login and activity logs kept"
          }
        },
        {
          "value": "awareness",
          "targetDays": 90,
          "label": {
            "ar": "توعية الموظفين خلال آخر سنة",
            "en": "Staff security awareness in the past year"
          }
        }
      ],
      "required": true
    },
    "tier": {
      "type": "derived",
      "label": {
        "ar": "مستوى الصرامة",
        "en": "Strictness level"
      },
      "options": [
        {
          "value": "basic",
          "label": {
            "ar": "أساسي",
            "en": "Basic"
          }
        },
        {
          "value": "enhanced",
          "label": {
            "ar": "معزز",
            "en": "Enhanced"
          }
        },
        {
          "value": "high",
          "label": {
            "ar": "مرتفع",
            "en": "High"
          }
        }
      ]
    }
  }
}